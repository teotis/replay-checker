# Replay Checker 环境变量配置
# 复制此文件为 .env 并填入实际的 API 密钥（仅在使用外部 LLM 分析时需要）

# LLM 提供商选择（openai / anthropic）
# REPLAY_CHECKER_LLM_PROVIDER=openai

# API 密钥（对应上述 provider）
# OPENAI_API_KEY=your-openai-api-key-here
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# 强制仅本地模式（设为 1 禁用所有外部 LLM 调用）
# REPLAY_CHECKER_LLM_OPT_OUT=0

# 上传范围控制
# REPLAY_CHECKER_MAX_UPLOAD_CHARS=4000
# REPLAY_CHECKER_MAX_UPLOAD_FILES=10
